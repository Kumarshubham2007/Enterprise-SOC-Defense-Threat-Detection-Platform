# ESMIR Platform Environment Configuration Example
# Copy this file to .env and configure secrets prior to deployment

APP_NAME="Enterprise Security Monitoring & Incident Response Platform (ESMIR)"
ENVIRONMENT="development"

# Security & Cryptography
# Generate a random 64-character hex key in production (e.g., openssl rand -hex 32)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="120"
COLLECTOR_TOKEN="replace-with-secure-shared-collector-token"

# Database Configuration
# Default: Local SQLite database in backend/data/esmir.db
DATABASE_URL="sqlite:///./data/esmir.db"

# For PostgreSQL production deployments:
# DATABASE_URL="postgresql+psycopg2://esmir_user:StrongPassword@localhost:5432/esmir_db"

# Server Bindings
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
FRONTEND_PORT="5173"
